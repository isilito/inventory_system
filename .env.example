# Copy this file to .env (XAMPP), or add the same names under
# Vercel → Project → Settings → Environment Variables.

# ---------- AI assistant ----------
# Your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING=LOW

# ---------- Database ----------
# Leave these out on XAMPP (it uses localhost / root / no password / partsbin).
# For a hosted MySQL, copy the values from the provider's dashboard:
# DB_HOST=your-host.example.com
# DB_PORT=3306
# DB_USER=your-user
# DB_PASS=your-password
# DB_NAME=partsbin
# DB_SSL=true
